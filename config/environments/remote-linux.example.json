{
  "schema_version": 1,
  "name": "Example: build and traffic on a Linux lab host",
  "build": {
    "executor": "ssh",
    "ssh_alias": "lab-builder",
    "task_root": "/srv/alwayroute",
    "project_workspace": "/srv/alwayroute/workspaces/AlwayRoute",
    "openwrt_tree": "/srv/alwayroute/openwrt-build/source",
    "toolchain_root": "/srv/alwayroute/toolchains",
    "cache_root": "/srv/alwayroute/build-cache",
    "output_root": "/srv/alwayroute/artifacts",
    "jobs": 8,
    "timeout_seconds": 7200,
    "disk_limit_bytes": 32212254720
  },
  "router": {
    "executor": "ssh",
    "executor_ssh_alias": "lab-builder",
    "target": "root@192.0.2.1",
    "ssh_port": 122,
    "identity_file": "/srv/alwayroute/keys/router_ed25519",
    "known_hosts_file": "/srv/alwayroute/keys/router_known_hosts",
    "connect_timeout_seconds": 10
  },
  "traffic": {
    "executor": "ssh",
    "ssh_alias": "lab-builder",
    "source_interface": "eth0",
    "source_address": "192.0.2.2",
    "gateway": "192.0.2.1"
  }
}
