# Optional AlwayRoute adapter only; combine with a matching existing target/SDK.
CONFIG_PACKAGE_alwayroute-external-manager=m
CONFIG_PACKAGE_alwayroute-external-forwarding=m
CONFIG_PACKAGE_luci-app-alwayroute-external=m
# CONFIG_PACKAGE_alwayroute-core is not set
# CONFIG_PACKAGE_alwayroute-manager is not set
# CONFIG_PACKAGE_alwayroute-forwarding is not set
# CONFIG_PACKAGE_luci-app-alwayroute is not set
CONFIG_BUSYBOX_CONFIG_NSLOOKUP=y
CONFIG_BUSYBOX_CONFIG_FEATURE_NSLOOKUP_BIG=y
CONFIG_BUSYBOX_CONFIG_FEATURE_NSLOOKUP_LONG_OPTIONS=y
CONFIG_BUSYBOX_CONFIG_LONG_OPTS=y
