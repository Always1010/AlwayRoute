#!/bin/sh /etc/rc.common
START=96
STOP=9
USE_PROCD=1

start_service() {
 [ -s /tmp/alwayroute/external-dns.conf ] || return 1
 procd_open_instance external_dns
 procd_set_param command /usr/sbin/dnsmasq -k --conf-file=/tmp/alwayroute/external-dns.conf
 procd_set_param respawn 3600 5 3
 procd_set_param limits core="0"
 procd_set_param stdout 0
 procd_set_param stderr 0
 procd_close_instance
}
