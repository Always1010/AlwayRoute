'use strict';
import { sha256 } from 'digest';
import { loadPolicies } from 'alwayroute.policies';

export function fail(code, message) { die('ALWAYROUTE:'+code+':'+message); };
export function clone(value) { return json(sprintf('%J', value)); };
function require(ok, message) { if (!ok) fail('INVALID_MODEL', message); }
function fields(value, allowed) {
 require(type(value) == 'object', '需要对象');
 for (let k in keys(value)) require(index(allowed, k) >= 0, '存在不支持的字段');
};
function text(value, max) {
 if(type(value)!='string' || !length(value) || length(value)>max)return false;
 for(let c in split(value,''))if(ord(c)<32 || ord(c)==127)return false;
 return true;
};
function id(value) { return type(value) == 'string' && match(value, /^[A-Za-z0-9_-]{1,64}$/) != null; }
function integer(value, min, max) { return type(value) == 'int' && value >= min && value <= max; }
const POLICY_VERSION = 2;
const LIMITS = {nodes:128,rules:512,subscriptions:16,groups:16,inputBytes:131072,ruleValues:128};
const POLICIES = loadPolicies();
export function modelLimits() { return clone(LIMITS); };
export function policyCatalog() { return clone(POLICIES); };
function policyMatch(id) {
 let result={domain:[],domain_suffix:[]},seen={};
 for(let p in POLICIES)if(p.id==id || (id=='Proxy' && p.id!='Domestic')) {
  for(let key,values in {domain:p.exactDomains,domain_suffix:p.domains})for(let value in values) {
   let identity=key+':'+value;
   if(!seen[identity]){push(result[key],value);seen[identity]=true;}
  }
 }
 return result;
};
function groupDefault(id) { return id=='Proxy' || id=='Other' || id=='Domestic'?'direct':'Proxy'; }
export function empty() {
 let groups=[];for(let p in POLICIES)if(p.default)push(groups,{id:p.id,name:p.name,selected:groupDefault(p.id)});
 return {schema:1,policyVersion:POLICY_VERSION,revision:0,mode:'rule',defaultOutbound:'Other',nodes:[],subscriptions:[],overrides:{},groups,rules:[]};
};
function ruleValues(r) { return r.values ?? [r.value]; }
function migratePolicies(n) {
 // Only remove unchanged rules generated by the former public service profile.
 // Edited, disabled or user-created rules retain their original priority.
 let catalog={};for(let p in POLICIES)catalog[p.id]=p;
 n.rules=filter(n.rules,function(r) {
  if(!r.enabled || (r.type!='domain' && r.type!='suffix') || length(ruleValues(r))!=1)return true;
  let value=ruleValues(r)[0],p=catalog[r.outbound];
  if(!p || index(r.type=='domain'?p.exactDomains:p.domains,value)<0)return true;
  return r.id!='route_'+substr(sha256(r.outbound+chr(0)+r.type+chr(0)+value),0,16);
 });
 for(let wanted in ['TikTok','Domestic']) {
  let present=false;for(let g in n.groups)if(g.id==wanted)present=true;
  if(!present && length(n.groups)<LIMITS.groups) {
   let other=pop(n.groups);push(n.groups,{id:wanted,name:catalog[wanted].name,selected:groupDefault(wanted)});push(n.groups,other);
  }
 }
 n.policyVersion=POLICY_VERSION;return n;
};
function legacyFallback(m) {
 let target=m.defaultOutbound;
 if(target=='Proxy')return target;
 if(type(m.groups)!='array')return target;
 for(let g in m.groups)if(g.id==target)return g.selected;
 return target;
};
export function normalize(m) {
 let n=clone(m);
 if(type(n)!='object' || n.policyVersion==POLICY_VERSION)return n;
 if(n.policyVersion==1 && type(n.groups)=='array' && type(n.rules)=='array')return migratePolicies(n);
 if(n.policyVersion!=null)return n;
 if(type(n.groups)!='array' || type(n.rules)!='array')return n;
 let fallback=legacyFallback(n), merged={GitHub:true,Netflix:true,Disney:true,Spotify:true}, kept=[];
 for(let g in n.groups)if(!merged[g.id])push(kept,g);
 for(let g in kept)if(merged[g.selected])g.selected='Proxy';
 for(let r in n.rules)if(merged[r.outbound])r.outbound='Proxy';
 n.groups=kept;
 let present={};for(let g in n.groups)present[g.id]=true;
 if(!present.Other && length(n.groups)<16){push(n.groups,{id:'Other',name:'Other',selected:fallback});present.Other=true;}
 else if(present.Other)for(let g in n.groups)if(g.id=='Other')g.selected=fallback;
 for(let p in POLICIES)if(p.default && p.id!='Other' && !present[p.id] && length(n.groups)<16){push(n.groups,{id:p.id,name:p.name,selected:groupDefault(p.id)});present[p.id]=true;}
 if(!present.Other)fail('MIGRATION_REQUIRED','策略组已满，无法在不删除自定义组的情况下添加 Other');
 let ordered=[],orderedIds={};
 for(let p in POLICIES)if(p.default && p.id!='Other')for(let g in n.groups)if(g.id==p.id){push(ordered,g);orderedIds[g.id]=true;}
 for(let g in n.groups)if(g.id!='Other' && !orderedIds[g.id])push(ordered,g);
 for(let g in n.groups)if(g.id=='Other')push(ordered,g);
 n.groups=ordered;n.defaultOutbound='Other';n.policyVersion=1;
 return migratePolicies(n);
};
export function node(n) {
 fields(n, ['id','name','type','enabled','source','sourceKey','server','port','uuid','security','alterId','tls','transport']);
 require(id(n.id) && text(n.name,128) && type(n.enabled) == 'bool', '节点标识、名称或开关无效');
 if (n.type != 'vmess') fail('UNSUPPORTED_PROTOCOL', '首版仅支持 VMess');
 require(n.source == null || id(n.source), '节点来源无效');
 require(text(n.server,253) && match(n.server, /^[A-Za-z0-9._:-]+$/), '服务器地址无效');
 require(integer(n.port,1,65535), '端口必须为 1..65535');
 require(type(n.uuid) == 'string' && match(n.uuid,/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/), 'VMess UUID 无效');
 require(index(['auto','aes-128-gcm','chacha20-poly1305','none','zero'],n.security ?? 'auto') >= 0, 'VMess 加密方式不支持');
 require(integer(n.alterId ?? 0,0,65535), 'alterId 无效');
 if (n.tls != null) {
  fields(n.tls,['enabled','serverName']);
  require(type(n.tls.enabled) == 'bool' && (n.tls.serverName == null || (text(n.tls.serverName,253) && match(n.tls.serverName,/^[A-Za-z0-9._-]+$/))), 'TLS 参数无效');
 }
 if (n.transport != null) {
  fields(n.transport,['type','path','host']);
  require(n.transport.type == 'ws', '首版仅支持 TCP 或 WebSocket 传输');
  require(n.transport.path == null || text(n.transport.path,1024), 'WebSocket 路径无效');
  require(n.transport.host == null || text(n.transport.host,253), 'WebSocket Host 无效');
 }
 return n;
};
export function effective(m, validated) {
 let result = [];
 for (let original in m.nodes) {
  let n = clone(original), o = m.overrides[n.id];
  if (o?.excluded) continue;
  if (o?.name != null) n.name = o.name;
  if (o?.patch) for (let k,v in o.patch) n[k] = v;
   // validate() already checked every source node. Only a patch can invalidate
   // those fields; its optional name was checked separately in the override.
   if(validated!==true && !(validated=='base' && !o?.patch))node(n);
  if (n.enabled) push(result,n);
 }
 return result;
};
export function validate(m) {
 fields(m,['schema','policyVersion','revision','mode','defaultOutbound','nodes','subscriptions','overrides','groups','rules']);
 require(m.schema == 1 && m.policyVersion == POLICY_VERSION && integer(m.revision,0,2147483646), '模型版本无效');
 require(index(['rule','global','direct'],m.mode)>=0,'模式无效');
 for (let key,limit in {nodes:LIMITS.nodes,subscriptions:LIMITS.subscriptions,groups:LIMITS.groups,rules:LIMITS.rules}) require(type(m[key])=='array' && length(m[key])<=limit,'数量超限或列表无效');
 require(type(m.overrides)=='object' && length(keys(m.overrides)) <= 128,'覆盖设置无效');
 let ids = {direct:true,block:true}, sourceIds = {};
 for (let s in m.subscriptions) {
  fields(s,['id','name','url','enabled','intervalHours','allowHttp','lastUpdate','lastError']);
  require(id(s.id) && !sourceIds[s.id] && length(s.id)<=20 && text(s.name,128),'订阅标识无效或重复'); sourceIds[s.id]=true;
  require(type(s.enabled)=='bool' && integer(s.intervalHours,0,168),'订阅开关或周期无效');
  require(s.allowHttp==null || type(s.allowHttp)=='bool','HTTP 例外必须为布尔开关');
  let schemeAllowed=type(s.url)=='string' && (index(s.url,'https://')==0 || (s.allowHttp===true && index(s.url,'http://')==0));
  require(text(s.url,2048) && schemeAllowed && !match(s.url,/[ "'<>\\]/),'订阅需要 HTTPS；HTTP 须对此订阅显式允许');
 }
 for (let n in m.nodes) { node(n); require(!ids[n.id],'节点ID重复'); ids[n.id]=true; require(n.source == null || sourceIds[n.source], '节点引用未知订阅'); }
 for (let key,o in m.overrides) {
  require(id(key),'覆盖标识无效'); fields(o,['excluded','name','patch']);
  require(o.excluded == null || type(o.excluded)=='bool','排除开关无效');
  require(o.name == null || text(o.name,128),'覆盖名称无效');
  if(o.patch) fields(o.patch,['server','port','uuid','security','alterId','tls','transport']);
 }
 let usable={direct:true,block:true}; for(let n in effective(m,'base')) usable[n.id]=true;
 let groupIds={};
 for (let g in m.groups) {
  fields(g,['id','name','selected']); require(id(g.id) && !ids[g.id] && !groupIds[g.id] && text(g.name,128),'策略组标识重复或无效');
  groupIds[g.id]=true;
 }
 require(groupIds.Proxy && groupIds.Other && m.groups[length(m.groups)-1].id=='Other', '必须保留 Proxy，并将 Other 保持在最后');
 for(let g in m.groups) require((g.selected!='block' && usable[g.selected]) || (g.id!='Proxy' && g.selected=='Proxy') || (g.id=='Other' && g.selected=='block'), '策略组选择不存在、被停用或形成循环');
 for(let k in keys(groupIds)) usable[k]=true;
 require(m.defaultOutbound=='Other', '默认出口必须由 Other 策略组管理');
 let ruleIds={};
 for(let r in m.rules) {
  fields(r,['id','enabled','type','value','values','outbound']);
  require(id(r.id) && !ruleIds[r.id] && type(r.enabled)=='bool','规则标识或开关无效'); ruleIds[r.id]=true;
  require(usable[r.outbound], '规则出口无效');
  require(index(['domain','suffix','regex','ip','cidr'],r.type)>=0,'规则类型不支持');
  require((r.value!=null)!=(r.values!=null),'规则必须只提供一个 value 或 values');
  let values=ruleValues(r);require(type(values)=='array' && length(values)>0 && length(values)<=LIMITS.ruleValues,'规则匹配值数量无效');
  let seen={};
  for(let value in values) {
   require(text(value,r.type=='regex'?1024:253) && !seen[value], '规则匹配值无效或重复');seen[value]=true;
   if(r.type=='ip' || r.type=='cidr') {
    let parts=split(value,'/'), octets=split(parts[0],'.');
    require(length(octets)==4 && length(parts)==(r.type=='cidr'?2:1),'仅支持 IPv4/IP CIDR');
    for(let octet in octets) require(match(octet,/^[0-9]{1,3}$/) && int(octet)<=255,'IPv4 地址无效');
    if(r.type=='cidr') require(match(parts[1],/^[0-9]{1,2}$/) && int(parts[1])<=32,'CIDR 前缀无效');
   } else if(r.type!='regex')require(match(value,/^[A-Za-z0-9._-]+$/),'域名规则无效');
  }
 }
 require(length(sprintf('%J',m))<=LIMITS.inputBytes,'配置超过128KiB');
 return m;
};
// Internal callers use this only after validating the complete, unchanged model.
export function generateValidated(m) {
 let outbounds=[{type:'direct',tag:'direct'}], choices=['direct'], rules=[{port:53,action:'hijack-dns'}],dnsRules=[],ruleSets=[],ipOverrides=[];
 // Only rule mode needs application hostnames; DNS must never wait for sniffing.
 if(m.mode=='rule')push(rules,{action:'sniff',sniffer:['http','tls','quic']});
 let selections={};for(let g in m.groups)selections[g.id]=g.selected;
 function domainDns(rule, target) {
  // Validation permits only one group reference: a non-Proxy group may follow Proxy.
  target=selections[target] ?? target;
  if(target=='Proxy')target=selections.Proxy;
  let d=target=='block'?{action:'reject'}:{server:target=='direct'?'bootstrap':'proxy-dns'};
  for(let key,value in rule)d[key]=value;
  push(dnsRules,d);
 }
 for(let n in effective(m,true)) {
  let o={type:'vmess',tag:n.id,server:n.server,server_port:n.port,uuid:n.uuid,security:n.security ?? 'auto',alter_id:n.alterId ?? 0};
  if(n.tls?.enabled) o.tls={enabled:true,server_name:n.tls.serverName ?? n.server};
  if(n.transport) o.transport={type:'ws',path:n.transport.path ?? '/',headers: n.transport.host ? {Host:n.transport.host}: {}};
  push(outbounds,o);push(choices,n.id);
 }
 for(let g in m.groups) {
  let selected=g.selected=='block'?'direct':g.selected,members=clone(choices);
  if(g.id!='Proxy' && index(members,'Proxy')<0)push(members,'Proxy');
  push(outbounds,{type:'selector',tag:g.id,outbounds:members,default:selected,interrupt_exist_connections:false});
 }
 if(m.mode=='rule') for(let r in m.rules) {
  if(!r.enabled) continue;
  let field=r.type=='domain'?'domain':r.type=='suffix'?'domain_suffix':r.type=='regex'?'domain_regex':'ip_cidr';
  let values=ruleValues(r);if(r.type=='ip')values=map(values,value=>value+'/32');
  let rule={};rule[field]=values;
  if(r.outbound=='block' || (r.outbound=='Other' && selections.Other=='block')) rule.action='reject'; else {rule.action='route';rule.outbound=r.outbound;}
  push(rules,rule);
  if(r.type=='ip' || r.type=='cidr')push(ipOverrides,rule);
  if(r.type=='domain' || r.type=='suffix' || r.type=='regex') {let d={};d[field]=values;domainDns(d,r.outbound);}
 }
 if(m.mode=='rule') {
  let groupIds={};for(let g in m.groups)groupIds[g.id]=true;
  for(let wanted in ['OpenAI','Claude','YouTube','TikTok','Google','X','Telegram','Microsoft','Apple','Meta','Discord','Steam','Proxy','Domestic']) {
   let matched=policyMatch(wanted);
   if(groupIds[wanted] && (length(matched.domain) || length(matched.domain_suffix))) {
    let rule=clone(matched);rule.action='route';rule.outbound=wanted;push(rules,rule);
    domainDns(matched,wanted);
   }
  }
  if(groupIds.Domestic) {
   // Keep the shared community data out of the model and capabilities response.
   push(ruleSets,{type:'local',tag:'domestic-domain',format:'binary',path:'/usr/share/alwayroute/rules/domestic-domain.srs'});
   push(rules,{rule_set:['domestic-domain'],action:'route',outbound:'Domestic'});
   domainDns({rule_set:['domestic-domain']},'Domestic');
   push(ruleSets,{type:'local',tag:'domestic-ip',format:'binary',path:'/usr/share/alwayroute/rules/domestic-ip.srs'});
   // Only unmatched domain destinations need resolution; IP destinations are unchanged.
   // Keep DNS routing (including its proxy fallback) rather than forcing local DNS.
   push(rules,{action:'resolve',strategy:'ipv4_only'});
   // An unresolved domain could not match an earlier user IP rule. Recheck those
   // overrides before the country fallback, preserving their original order.
   for(let rule in ipOverrides)push(rules,clone(rule));
   push(rules,{rule_set:['domestic-ip'],action:'route',outbound:'Domestic'});
  }
 }
 let final=m.mode=='direct'?'direct':m.mode=='global'?'Proxy':'Other';
 if(m.mode=='rule' && selections.Other=='block') {push(rules,{action:'reject'});push(dnsRules,{action:'reject'});final='direct';}
 return {log:{disabled:true},inbounds:[{type:'mixed',tag:'local-mixed',listen:'127.0.0.1',listen_port:7890},
 {type:'tproxy',tag:'lan-tproxy',listen:'0.0.0.0',listen_port:7893}],outbounds,
 dns:{servers:[{type:'local',tag:'bootstrap'},{type:'https',tag:'proxy-dns',server:'1.1.1.1',tls:{enabled:true,server_name:'cloudflare-dns.com'},detour:'Proxy'}],rules:dnsRules,final:m.mode=='direct'?'bootstrap':'proxy-dns',reverse_mapping:true,strategy:'ipv4_only',cache_capacity:1024},
 route:{rules,rule_set:ruleSets,final,auto_detect_interface:true,default_domain_resolver:'bootstrap'},experimental:{clash_api:{external_controller:'127.0.0.1:9090',access_control_allow_origin:['http://127.0.0.1'],default_mode:m.mode=='direct'?'Direct':m.mode=='global'?'Global':'Rule'}}};
};
// Runtime credentials are internal state. Public generate() remains a pure
// model projection so a secret can never enter the user model or RPC result.
export function generateRuntimeValidated(m,secret) {
 if(type(secret)!='string' || !match(secret,/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/))fail('CORE_CREDENTIAL_FAILED','核心接口凭据不可用');
 let config=generateValidated(m);config.experimental.clash_api.secret=secret;return config;
};
export function generate(m) {
 validate(m);
 return generateValidated(m);
};
