+@@ -1060,6 +1061,10 @@
+ 	bool ssl = cl->url->prefix == PREFIX_HTTPS;
+ 	int ret;
+ 
++	// Reject before creating a socket, including every redirected request.
++	if (uh->https_only && (!ssl || cl->proxy_url))
++		return -EPERM;
++
+ 	if (!cl->eof || uh->disconnect || uh->connection_close || uh->ssl != ssl)
+ 		uclient_http_disconnect(uh);
+ 
+@@ -1138,6 +1143,16 @@
+ 	}
+ 
+ 	return -1;
++}
++
++int uclient_http_set_https_only(struct uclient *cl, bool required)
++{
++	struct uclient_http *uh = container_of(cl, struct uclient_http, uc);
++
++	if (cl->backend != &uclient_backend_http || uh->state > HTTP_STATE_INIT)
++		return -EINVAL;
++	uh->https_only = required;
++	return 0;
+ }
+ 
+ int uclient_http_set_header_limits(struct uclient *cl, unsigned int bytes,
+@@ -1332,6 +1347,10 @@
+ 	url = uclient_get_url_location(url, blobmsg_data(tb));
+ 	if (!url)
+ 		return false;
++	if (uh->https_only && url->prefix != PREFIX_HTTPS) {
++		free(url);
++		return -EPERM;
++	}
+ 
+ 	/* RFC 9110 §15.4.4: a 303 response is retrieved with GET (a HEAD stays HEAD) */
+ 	if (cl->status_code == 303 && uh->req_type != REQ_HEAD)
