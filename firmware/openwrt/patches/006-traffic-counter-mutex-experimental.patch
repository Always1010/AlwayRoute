--- /dev/null
+++ b/experimental/clashapi/trafficontrol/counter.go
@@ -0,0 +1,33 @@
+package trafficontrol
+
+import "sync"
+
+// TrafficCounter retains immediate, full-width statistics without the single
+// process-wide runtime lock used by atomic.Int64 on 32-bit MIPS. Every access
+// holds this counter's own mutex; its zero value is ready for use.
+// A TrafficCounter must not be copied after first use.
+type TrafficCounter struct {
+	access sync.Mutex
+	value  int64
+}
+
+func (c *TrafficCounter) Load() int64 {
+	c.access.Lock()
+	value := c.value
+	c.access.Unlock()
+	return value
+}
+
+func (c *TrafficCounter) Store(value int64) {
+	c.access.Lock()
+	c.value = value
+	c.access.Unlock()
+}
+
+func (c *TrafficCounter) Add(delta int64) int64 {
+	c.access.Lock()
+	c.value += delta
+	value := c.value
+	c.access.Unlock()
+	return value
+}
