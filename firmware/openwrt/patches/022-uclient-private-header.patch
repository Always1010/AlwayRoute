++/* Read one private header without ever exposing its contents in argv. */
++static char *read_private_header(const char *path)
++{
++	struct stat st;
++	ssize_t n;
++	size_t used = 0;
++	char extra;
++	int fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
++
++	if (fd < 0)
++		return NULL;
++	if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_uid != geteuid() ||
++	    (st.st_mode & 077) || st.st_nlink != 1 || st.st_size <= 0 || st.st_size > 1024)
++		goto fail;
++	while (used < sizeof(private_header) - 1) {
++		n = read(fd, private_header + used, sizeof(private_header) - 1 - used);
++		if (n < 0 && errno == EINTR)
++			continue;
++		if (n < 0)
++			goto fail;
++		if (!n)
++			break;
++		used += n;
++	}
++	do { n = read(fd, &extra, 1); } while (n < 0 && errno == EINTR);
++	if (n != 0 || !used || memchr(private_header, 0, used))
++		goto fail;
++	close(fd);
++	if (private_header[used - 1] == '\n')
++		used--;
++	if (!used || memchr(private_header, '\r', used) || memchr(private_header, '\n', used))
++		return NULL;
++	private_header[used] = 0;
++	return private_header;
++fail:
++	close(fd);
++	return NULL;
++}
