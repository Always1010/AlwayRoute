#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

# This package is always external, including a fresh install with no mode file.
start_service() {
 /usr/libexec/alwayroute-external-supervisor start || return 1
 procd_open_instance recovery
 procd_set_param command /usr/libexec/alwayroute-external-supervisor
 procd_set_param respawn 3600 5 0
 procd_set_param term_timeout 25
 procd_close_instance
}
stop_service() {
 if [ "${AR_EXTERNAL_SHUTDOWN:-0}" = 1 ]; then
  /usr/libexec/alwayroute-external shutdown >/dev/null || exit 1
 else
  /usr/libexec/alwayroute-external disable >/dev/null || exit 1
 fi
}
# rc.common normally maps shutdown to stop. Preserve the durable user intent
# and retain the source guard until the base network is taken down.
shutdown() {
 /usr/libexec/alwayroute-external-supervisor pause || return 1
 AR_EXTERNAL_SHUTDOWN=1; stop
}
restart() { start; }
reload_service() { /usr/libexec/alwayroute-external-supervisor event; }
service_triggers() {
 procd_add_reload_trigger firewall network
 procd_add_interface_trigger "interface.*" "*" /etc/init.d/alwayroute reload
}
