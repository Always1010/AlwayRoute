CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-4a-gigabit=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=512
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL_NONSHARED is not set
# CONFIG_TARGET_MULTI_PROFILE is not set

CONFIG_PACKAGE_alwayroute-core=y
CONFIG_PACKAGE_alwayroute-forwarding=y
CONFIG_PACKAGE_alwayroute-manager=y
CONFIG_PACKAGE_luci-app-alwayroute=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-tiny=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

# The current upstream is router B via DHCP. This evaluation image omits PPP.
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_kmod-ppp is not set
# CONFIG_PACKAGE_kmod-pppoe is not set
# CONFIG_PACKAGE_kmod-pppox is not set
# CONFIG_PACKAGE_kmod-slhc is not set
# CONFIG_PACKAGE_luci-proto-ppp is not set

# Reduce kernel diagnostic data; retain normal network and wireless features.
# CONFIG_KERNEL_KALLSYMS is not set
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_INFO_BTF is not set
# CONFIG_KERNEL_DEBUG_KERNEL is not set

# This candidate is an evaluation image, not an ImageBuilder or SDK release.
# CONFIG_IB is not set
# CONFIG_SDK is not set
# CONFIG_MAKE_TOOLCHAIN is not set
